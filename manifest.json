{
  "manifest_version": 3,
  "name": "TickTick Page Saver",
  "version": "1.0",
  "description": "Save the current tab as a TickTick task with one click.",
  "permissions": ["identity", "activeTab", "storage"],
  "host_permissions": [
    "https://ticktick.com/*",
    "https://api.ticktick.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
